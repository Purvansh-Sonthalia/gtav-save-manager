
{
    "manifest_version": 3,
    "name": "GTA Cloud Sync",
    "version": "1.0.0",
    "description": "Back up, restore, and manage PlayGTA5 saves and graphics settings via Supabase.",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "permissions": [
      "storage",
      "tabs"
    ],
    "host_permissions": [
      "https://playgta5.com/*",
      "https://www.playgta5.com/*",
      "https://cdn.playgta5.pro/*",
      "https://playgta5.pro/*",
      "https://www.playgta5.pro/*",
      "https://skoazyiuivhfaryemjqa.supabase.co/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "GTA Cloud Sync",
      "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon48.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "content_scripts": [
      {
        "matches": [
          "https://playgta5.com/*",
          "https://www.playgta5.com/*",
          "https://cdn.playgta5.pro/*",
          "https://playgta5.pro/*",
          "https://www.playgta5.pro/*"
        ],
        "js": [
          "save-paths.js",
          "content.js",
          "playgta5-pro-launch.js",
          "settings-panel-pro.js",
          "settings-panel.js"
        ],
        "run_at": "document_idle"
      }
    ]
  }
  